{
  "name": "gh-copilot-in-chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm test && npm run test:e2e",
    "companion:install": "node src/companion/install-cli.ts",
    "companion:uninstall": "node src/companion/install-cli.ts --uninstall"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.14"
  }
}
